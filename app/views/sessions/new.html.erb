<div class="auth-card">
  <div class="brand brand--dark">
    <span class="brand__logo">CH</span>
    <span class="brand__name">CuentaHogar</span>
  </div>
  <h1>Back-office</h1>
  <p class="muted">Ingresá con una cuenta de administrador.</p>

  <% if alert.present? %><div class="flash flash--alert"><%= alert %></div><% end %>
  <% if notice.present? %><div class="flash flash--notice"><%= notice %></div><% end %>

  <%= form_with url: session_path, class: "form" do |form| %>
    <div class="field">
      <%= form.label :email_address, "Email" %>
      <%= form.email_field :email_address, required: true, autofocus: true, autocomplete: "username",
                                           value: params[:email_address] %>
    </div>
    <div class="field">
      <%= form.label :password, "Contraseña" %>
      <%= form.password_field :password, required: true, autocomplete: "current-password", maxlength: 72 %>
    </div>
    <%= form.submit "Ingresar", class: "btn btn--primary btn--block" %>
  <% end %>

  <p class="auth-card__footer"><%= link_to "¿Olvidaste tu contraseña?", new_password_path %></p>
</div>
