<%= form_with model: [ :admin, income ], class: "form panel pad" do |form| %>
  <%= render "admin/shared/errors", record: income %>

  <div class="form-grid">
    <div class="field field--wide">
      <%= form.label :description %>
      <%= form.text_field :description, required: true, placeholder: "Sueldo septiembre" %>
    </div>
    <div class="field">
      <%= form.label :amount %>
      <%= form.number_field :amount, step: "0.01", min: "0.01", required: true %>
    </div>
    <div class="field">
      <%= form.label :received_on %>
      <%= form.date_field :received_on, required: true %>
    </div>
    <div class="field">
      <%= form.label :user_id, "Miembro" %>
      <%= form.collection_select :user_id, @users, :id, :name, { prompt: "Elegí un usuario" }, required: true %>
    </div>
    <div class="field">
      <%= form.label :household_id, "Hogar" %>
      <%= form.collection_select :household_id, @households, :id, :name, include_blank: "Personal (sin hogar)" %>
    </div>
  </div>

  <div class="form-actions">
    <%= form.submit "Guardar ingreso", class: "btn btn--primary" %>
    <%= link_to "Cancelar", admin_incomes_path, class: "btn" %>
  </div>
<% end %>
