<% content_for :title, @user.name %>
<% content_for :eyebrow, "Usuario" %>
<% content_for :actions do %>
  <%= link_to "Editar", edit_admin_user_path(@user), class: "btn" %>
  <%= button_to "Eliminar", admin_user_path(@user), method: :delete, class: "btn btn--danger",
                form: { data: { turbo_confirm: "¿Eliminar a #{@user.name} y todos sus movimientos?" } } %>
<% end %>

<section class="grid-2">
  <div class="panel pad">
    <dl class="details">
      <dt>Email</dt><dd><%= @user.email_address %></dd>
      <dt>Rol</dt><dd><%= enum_label(User, :role, @user.role) %></dd>
      <dt>Gastos cargados</dt><dd><%= @expenses_count %></dd>
      <dt>Alta</dt><dd><%= l(@user.created_at) %></dd>
    </dl>
  </div>
  <div class="panel">
    <div class="panel__header"><h2>Hogares</h2></div>
    <table class="table">
      <tbody>
        <% @memberships.each do |membership| %>
          <tr>
            <td><%= link_to membership.household.name, admin_household_path(membership.household) %></td>
            <td><%= enum_label(Membership, :role, membership.role) %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
    <% if @memberships.empty? %><p class="muted pad">No pertenece a ningún hogar.</p><% end %>
  </div>
</section>
